# Segreti e configurazioni locali: versionare solo esempi privi di credenziali.
.env
.env.*
!.env.example
!.env.sample
secrets/
.ssh/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Log locali; le evidenze nei report devono essere selezionate e anonimizzate.
*.log
/.codex-log/

# Copie locali di backup: mantenere versionata soltanto la guida della cartella.
/backup/**
!/backup/README.md

# Artefatti e dati locali Tunet, mai sorgenti o lockfile.
/progetto/acasystem/node_modules/
/progetto/acasystem/*/node_modules/
/progetto/acasystem/frontend/dist/
/progetto/acasystem/backend/data/
/progetto/acasystem/frontend/playwright-report/
/progetto/acasystem/frontend/test-results/

# Istantanee di versione al posto dei commit (ADR-0008): restano solo sulla macchina.
/usa-come-git/**
