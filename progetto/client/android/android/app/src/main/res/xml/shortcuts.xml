<?xml version="1.0" encoding="utf-8"?>
<!-- Pressione lunga sull'icona: «Cambia indirizzo» riapre la procedura guidata. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="change_address"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_change_address"
        android:shortcutLongLabel="@string/shortcut_change_address">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="acasystem://change-address"
            android:targetPackage="it.acasystem.client"
            android:targetClass="it.acasystem.client.MainActivity" />
    </shortcut>
</shortcuts>
