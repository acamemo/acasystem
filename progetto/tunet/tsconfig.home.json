{
  "extends": "./tsconfig.typecheck.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "checkJs": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "@testing-library/jest-dom/vitest",
      "vitest/globals"
    ]
  },
  "include": [
    "src/primitives/**/*.ts",
    "src/primitives/**/*.tsx",
    "src/types/home.ts",
    "src/layouts/Header.tsx",
    "src/layouts/EditToolbar.tsx",
    "src/layouts/SettingsMenuControl.tsx",
    "src/components/pages/PageNavigation.tsx",
    "src/components/pages/home/**/*.tsx",
    "src/components/ui/SettingsDropdown.tsx",
    "src/types/global.d.ts",
    "src/__tests__/HomeMigration.test.tsx",
    "src/types/management.ts",
    "src/modals/AddCardContent.tsx",
    "src/modals/AddPageModal.tsx",
    "src/modals/EditPageModal.tsx",
    "src/components/ui/IconPicker.tsx",
    "src/__tests__/ManagementMigration.test.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
