{
  "name": "casa3d",
  "private": true,
  "version": "0.1.0",
  "description": "Casa 3D: vista 3D e editor della casa per Acasystem, base copiata da un progetto MIT di terzi (vedi NOTICE e PATCHES.md)",
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "rinomina": "node tools/rinomina.mjs",
    "marchio": "node tools/controlla-marchio.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run typecheck && npm run marchio",
    "build": "node build.mjs"
  },
  "dependencies": {
    "lit": "3.3.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
