* text=auto
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
# Gli archivi originali devono conservare esattamente i byte acquisiti.
documentazione/archive/** -text
# Le reference testuali mantengono i byte acquisiti, incluse le terminazioni.
documentazione/design/componenti/originali/** -text
documentazione/design/componenti/fonti/** -text
documentazione/design/componenti/integrita.json text eol=lf

# Conservare i byte acquisiti da upstream anche su checkout Windows.
progetto/tunet/** -text
progetto/compose.tunet.yaml text eol=lf
progetto/tunet-origin.json text eol=lf
