{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "acasystem-frontend-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "progetto/acasystem/frontend",
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "acasystem-frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "progetto/acasystem/frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5179",
        "--strictPort"
      ],
      "port": 5179
    },
    {
      "name": "schermata-avvio-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4189", "--bind", "127.0.0.1", "--directory", "progetto/ha-app/out/schermata-avvio-preview"],
      "port": 4189
    }
  ]
}